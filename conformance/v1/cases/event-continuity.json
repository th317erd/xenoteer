{
  "format_version": 1,
  "license": "Apache-2.0",
  "suite": "events.continuity",
  "description": "Concrete WebSocket frames exercise replay, resynchronization, filtering, and bounded queues.",
  "cases": [
    {
      "id": "event.cursor-zero",
      "description": "The canonical zero cursor is retained as an explicit lower bound and advances only after admission.",
      "operation": "event_continuity",
      "input": {
        "desktop_id": "20000000-0000-4000-8000-000000000001",
        "desktop_generation": "30000000-0000-4000-8000-000000000001",
        "cursor_generation": "30000000-0000-4000-8000-000000000001",
        "subscription_request_id": "10000000-0000-4000-8000-000000000107",
        "topics": ["window.changed"],
        "initial_cursor": "0",
        "queue_capacity": 2,
        "frames": [
          {
            "type": "event",
            "request_id": "10000000-0000-4000-8000-000000000107",
            "event": {
              "desktop_id": "20000000-0000-4000-8000-000000000001",
              "desktop_generation": "30000000-0000-4000-8000-000000000001",
              "sequence": "1",
              "topic": "window.changed",
              "payload": {"cursor": "zero"}
            }
          }
        ]
      },
      "expect": {
        "delivered_sequences": ["1"],
        "final_cursor": "1",
        "terminal": null,
        "resync_reason": null,
        "refresh_required": false,
        "generation_changed": false
      },
      "tags": ["boundary", "event", "sequence"]
    },
