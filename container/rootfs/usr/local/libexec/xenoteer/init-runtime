#!/bin/sh
# SPDX-License-Identifier: BUSL-1.1
set -eu

root=${CONTAINER_TEST_ROOT:-}
if [ -z "$root" ] && [ "$(id -u)" -ne 0 ]; then
  echo 'runtime initialization must run as root' >&2
  exit 1
fi
runtime_uid=1000
runtime_gid=1000
daemon_uid=1001
daemon_gid=1001
broker_uid=0
token_uid=0
token_gid=0
if [ -n "$root" ]; then
  runtime_uid=${CONTAINER_TEST_UID:-1000}
  runtime_gid=${CONTAINER_TEST_GID:-1000}
  daemon_uid=${CONTAINER_TEST_DAEMON_UID:-$runtime_uid}
  daemon_gid=${CONTAINER_TEST_DAEMON_GID:-$runtime_gid}
  broker_uid=${CONTAINER_TEST_BROKER_UID:-$runtime_uid}
  token_uid=${CONTAINER_TEST_TOKEN_UID:-$runtime_uid}
  token_gid=${CONTAINER_TEST_TOKEN_GID:-$runtime_gid}
fi
case "$runtime_uid:$runtime_gid:$daemon_uid:$daemon_gid:$broker_uid:$token_uid:$token_gid" in
  *[!0-9:]*|:*|*:) echo 'invalid test runtime identity' >&2; exit 64 ;;
esac

display=${DISPLAY:-:99}
width=${XVFB_SCREEN_WIDTH-1920}
height=${XVFB_SCREEN_HEIGHT-1080}
depth=${XVFB_SCREEN_DEPTH-24}
profile=${DESKTOP_PROFILE:-bare}
viewer_enabled=${VIEWER_ENABLED:-1}
viewer_required=${VIEWER_REQUIRED:-0}
http_addr=${XENOTEER__SERVER__LISTEN-0.0.0.0:8080}
if [ "${XENOTEER__AUTH__TOKEN_FILE+x}" = x ]; then
  token_file=$XENOTEER__AUTH__TOKEN_FILE
  token_file_explicit=1
else
  token_file=/run/secrets/xenoteer_api_token
  token_file_explicit=0
fi

case "$display" in :[0-9]*) ;; *) echo "invalid DISPLAY: $display" >&2; exit 64 ;; esac
case "${display#:}" in *[!0-9]*|'') echo "invalid DISPLAY: $display" >&2; exit 64 ;; esac
if [ "$width" != 1920 ] || [ "$height" != 1080 ] || [ "$depth" != 24 ]; then
  echo 'Phase 2 requires fixed Xvfb geometry 1920x1080x24 at 96 DPI' >&2
  exit 64
fi
case "$profile" in bare|standard) ;; *) echo "invalid desktop profile: $profile" >&2; exit 64 ;; esac
case "$viewer_enabled" in 0|1) ;; *) echo 'invalid viewer enabled setting' >&2; exit 64 ;; esac
case "$viewer_required" in 0|1) ;; *) echo 'invalid viewer required setting' >&2; exit 64 ;; esac
if [ "$viewer_required" = 1 ] && [ "$viewer_enabled" != 1 ]; then
  echo 'a required viewer cannot be disabled' >&2
  exit 64
fi
printf '%s' "$http_addr" | grep -Eq '^(127\.0\.0\.1|0\.0\.0\.0):[1-9][0-9]{0,4}$' || {
  echo "invalid XENOTEER__SERVER__LISTEN: $http_addr" >&2
  exit 64
}
http_port=${http_addr##*:}
[ "$http_port" -le 65535 ] || { echo "invalid HTTP port: $http_port" >&2; exit 64; }
case "$token_file" in /*) ;; *) echo 'XENOTEER__AUTH__TOKEN_FILE must be absolute' >&2; exit 64 ;; esac
case "$token_file" in *..*) echo 'XENOTEER__AUTH__TOKEN_FILE may not contain ..' >&2; exit 64 ;; esac
case "$token_file" in /run/xenoteer/api-token) echo 'authentication token source collides with its staging path' >&2; exit 64 ;; esac
token_path="$root$token_file"
if [ ! -f "$token_path" ] && [ "$token_file_explicit" -eq 0 ]; then
  token_file=/run/xenoteer/generated-api-token
  token_path="$root$token_file"
  if [ ! -f "$token_path" ]; then
    install -d -m 0755 "$root/run/xenoteer"
    umask 077
    od -An -N32 -tx1 /dev/urandom | tr -d ' \n' >"$token_path"
    chown "$token_uid:$token_gid" "$token_path"
    chmod 0400 "$token_path"
    echo "generated API bearer token is available to root at $token_file" >&2
  fi
fi
[ -f "$token_path" ] || { echo 'explicit authentication token file is missing' >&2; exit 78; }
[ ! -L "$token_path" ] || { echo 'authentication token file may not be a symbolic link' >&2; exit 78; }
token_owner=$(stat -c '%u' "$token_path")
token_mode=$(stat -c '%a' "$token_path")
token_bytes=$(wc -c <"$token_path")
[ "$token_owner" -eq "$token_uid" ] || { echo 'authentication token file must be owned by root' >&2; exit 78; }
case "$token_mode" in 400|600) ;; *) echo "authentication token file must have mode 0400 or 0600 (observed $token_mode)" >&2; exit 78 ;; esac
[ "$token_bytes" -ge 32 ] || { echo 'authentication token must contain at least 32 bytes of token material' >&2; exit 78; }
[ "$token_bytes" -le 1026 ] || { echo 'authentication token file exceeds the 1026-byte handoff limit' >&2; exit 78; }

shm_path=${SHM_PATH:-/dev/shm}
shm_bytes=$(df -B1 --output=size "$shm_path" | awk 'NR == 2 { gsub(/ /, ""); print }')
shm_mode=$(stat -c '%a' "$shm_path")
[ "$shm_mode" = 1777 ] || { echo "$shm_path must have mode 1777 (observed $shm_mode)" >&2; exit 78; }
[ "$shm_bytes" -ge 4294967296 ] || {
  echo "$shm_path must be at least 4 GiB; Debian Chromium enables --disable-dev-shm-usage below 4080218931 available bytes (observed $shm_bytes bytes)" >&2
  exit 78
}

umask 077
install -d -m 0755 "$root/run/xenoteer"
install -d -m 0710 -o "$runtime_uid" -g "$runtime_gid" "$root/run/xenoteer/bus"
install -d -m 0710 -o "$runtime_uid" -g "$runtime_gid" "$root/run/xenoteer/bus/at-spi"
install -d -m 0750 -o "$broker_uid" -g "$daemon_gid" "$root/run/xenoteer/processd"
install -d -m 0710 -o "$runtime_uid" -g "$runtime_gid" "$root/run/user/1000"
install -d -m 0710 -o "$runtime_uid" -g "$runtime_gid" "$root/run/user/1000/at-spi"
install -d -m 0700 -o "$runtime_uid" -g "$runtime_gid" "$root/run/user/1000/xdg"
install -d -m 0700 -o "$runtime_uid" -g "$runtime_gid" "$root/run/user/1000/xdg/config"
install -d -m 0700 -o "$runtime_uid" -g "$runtime_gid" "$root/run/user/1000/xdg/cache"
install -d -m 0700 -o "$runtime_uid" -g "$runtime_gid" "$root/run/user/1000/xdg/data"
install -d -m 0700 -o "$daemon_uid" -g "$daemon_gid" "$root/run/user/1001"
install -d -m 0700 -o "$daemon_uid" -g "$daemon_gid" "$root/run/user/1001/home"
install -d -m 0700 -o "$daemon_uid" -g "$daemon_gid" "$root/run/user/1001/xdg"
install -d -m 0700 -o "$daemon_uid" -g "$daemon_gid" "$root/run/user/1001/xdg/config"
install -d -m 0700 -o "$daemon_uid" -g "$daemon_gid" "$root/run/user/1001/xdg/cache"
install -d -m 0700 -o "$daemon_uid" -g "$daemon_gid" "$root/run/user/1001/xdg/data"
install -d -m 0700 -o "$runtime_uid" -g "$runtime_gid" "$root/home/xenoteer"
install -d -m 0755 "$root/run/xenoteer/env"
install -d -m 0755 "$root/run/xenoteer/viewer"
install -d -m 1777 "$root/tmp/.X11-unix"
install -d -m 1777 "$root/tmp/.ICE-unix"
if [ "$(id -u)" -eq 0 ]; then
  chown 0:0 "$root/tmp/.X11-unix" "$root/tmp/.ICE-unix"
fi
install -m 0600 -o "$runtime_uid" -g "$runtime_gid" /dev/null "$root/run/user/1000/ICEauthority"
install -m 0400 -o "$token_uid" -g "$token_gid" "$token_path" "$root/run/xenoteer/api-token"

write_env() {
  name=$1
  value=$2
  printf '%s' "$value" >"$root/run/xenoteer/env/$name"
  chmod 0644 "$root/run/xenoteer/env/$name"
}

write_env DISPLAY "$display"
write_env XAUTHORITY "$root/run/user/1000/Xauthority"
write_env ICEAUTHORITY "$root/run/user/1000/ICEauthority"
write_env HOME "$root/home/xenoteer"
write_env XDG_RUNTIME_DIR "$root/run/user/1000"
write_env XDG_CONFIG_HOME "$root/run/user/1000/xdg/config"
write_env XDG_CACHE_HOME "$root/run/user/1000/xdg/cache"
write_env XDG_DATA_HOME "$root/run/user/1000/xdg/data"
write_env XDG_CONFIG_DIRS "$root/etc/xdg"
write_env XDG_DATA_DIRS "$root/usr/local/share:$root/usr/share"
write_env DBUS_SESSION_BUS_ADDRESS "unix:path=$root/run/xenoteer/bus/session"
write_env AT_SPI_BUS_ADDRESS "unix:path=$root/run/xenoteer/bus/at-spi/bus_${display#:}"
write_env XDG_CURRENT_DESKTOP XFCE
write_env XDG_SESSION_DESKTOP xfce
write_env XDG_SESSION_TYPE x11
write_env DESKTOP_SESSION xfce
write_env LANG en_US.UTF-8
write_env LC_ALL en_US.UTF-8
write_env TZ UTC
write_env NO_AT_BRIDGE 0
write_env GTK_OVERLAY_SCROLLING 0
write_env GDK_SCALE 1
write_env GDK_DPI_SCALE 1
write_env QT_LINUX_ACCESSIBILITY_ALWAYS_ON 1
write_env QT_AUTO_SCREEN_SCALE_FACTOR 0
write_env QT_SCALE_FACTOR 1
write_env QT_FONT_DPI 96
write_env QT_STYLE_OVERRIDE Fusion
write_env XENOTEER__SERVER__LISTEN "$http_addr"
write_env DESKTOP_PROFILE "$profile"
write_env VIEWER_ENABLED "$viewer_enabled"
write_env VIEWER_REQUIRED "$viewer_required"
write_env XVFB_SCREEN_WIDTH "$width"
write_env XVFB_SCREEN_HEIGHT "$height"
write_env XVFB_SCREEN_DEPTH "$depth"
write_env XVFB_SCREEN_GEOMETRY "${width}x${height}x${depth}"

# with-contenv supplies the original container environment only to this
# initialization oneshot. Validate every Xenoteer key with the same two-segment
# grammar as the Rust loader, then persist its value byte-for-byte for s6-envdir.
# Diagnostics deliberately contain neither attacker-controlled names nor values.
awk -v output_dir="$root/run/xenoteer/env" '
  BEGIN { RS = "\0" }

  function valid_segment(segment) {
    return segment ~ /^[A-Z0-9]+(_[A-Z0-9]+)*$/
  }

  {
    equals = index($0, "=")
    if (equals == 0) {
      next
    }
    name = substr($0, 1, equals - 1)
    if (substr(name, 1, 9) != "XENOTEER_") {
      next
    }
    if (substr(name, 1, 10) != "XENOTEER__") {
      invalid = 1
      next
    }
    path = substr(name, 11)
    count = split(path, segments, /__/)
    if (count != 2 || !valid_segment(segments[1]) || !valid_segment(segments[2])) {
      invalid = 1
      next
    }
    # The root launcher hands this secret to xenoteerd on a private inherited
    # descriptor. Never materialize its external path in the shared envdir.
    if (name == "XENOTEER__AUTH__TOKEN_FILE") {
      next
    }
    value = substr($0, equals + 1)
    destination = output_dir "/" name
    # s6-envdir -f (without -n) chomps exactly this terminator. An empty value
    # therefore remains an empty variable instead of becoming an unset one;
    # values that already end in newlines retain every original newline.
    printf "%s\n", value > destination
    close(destination)
  }

  END {
    if (invalid) {
      print "invalid Xenoteer environment configuration key" > "/dev/stderr"
      exit 64
    }
  }
' /proc/self/environ
chmod 0644 "$root"/run/xenoteer/env/XENOTEER__*

printf '%s\n' "$shm_bytes" >"$root/run/xenoteer/shm-bytes"
chmod 0644 "$root/run/xenoteer/shm-bytes"
