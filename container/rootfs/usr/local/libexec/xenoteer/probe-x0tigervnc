#!/bin/sh
# SPDX-License-Identifier: BUSL-1.1
set -eu

[ "${VIEWER_ENABLED:?viewer enabled setting is missing}" = 1 ]
exec env PYTHONDONTWRITEBYTECODE=1 python3 -c '
import socket
import struct

MAX_RFB_NAME_BYTES = 4_096


def receive_exact(connection, length):
    value = bytearray()
    while len(value) < length:
        chunk = connection.recv(length - len(value))
        if not chunk:
            raise RuntimeError("RFB connection closed during handshake")
        value.extend(chunk)
    return bytes(value)

with socket.create_connection(("127.0.0.1", 5900), timeout=2.0) as connection:
    connection.settimeout(2.0)
    if receive_exact(connection, 12) != b"RFB 003.008\n":
        raise RuntimeError("unexpected RFB banner")
    connection.sendall(b"RFB 003.008\n")
    security_count = receive_exact(connection, 1)[0]
    if security_count == 0:
        reason_length = struct.unpack(">I", receive_exact(connection, 4))[0]
        if reason_length > MAX_RFB_NAME_BYTES:
            raise RuntimeError("RFB rejection reason exceeded its bound")
        receive_exact(connection, reason_length)
        raise RuntimeError("RFB server rejected security negotiation")
    security_types = receive_exact(connection, security_count)
    if 1 not in security_types:
        raise RuntimeError("RFB None security is unavailable on loopback")
    connection.sendall(b"\x01")
    if struct.unpack(">I", receive_exact(connection, 4))[0] != 0:
        raise RuntimeError("RFB security negotiation failed")
    connection.sendall(b"\x01")
    server_init = receive_exact(connection, 24)
    width, height = struct.unpack(">HH", server_init[:4])
    if (width, height) != (1920, 1080):
        raise RuntimeError("RFB server returned unexpected geometry")
    name_length = struct.unpack(">I", server_init[20:24])[0]
    if name_length > MAX_RFB_NAME_BYTES:
        raise RuntimeError("RFB desktop name exceeded its bound")
    receive_exact(connection, name_length)
'
