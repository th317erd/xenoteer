#!/bin/sh
# SPDX-License-Identifier: BUSL-1.1
set -eu

: "${DBUS_SESSION_BUS_ADDRESS:?session bus address is required}"
: "${AT_SPI_BUS_ADDRESS:?accessibility bus address is required}"
root=${CONTAINER_TEST_ROOT:-}
case "${DISPLAY:?display is required}" in
  :[0-9]*) display_number=${DISPLAY#:} ;;
  *) exit 1 ;;
esac
case "$display_number" in *[!0-9]*|'') exit 1 ;; esac
expected="unix:path=$root/run/xenoteer/bus/at-spi/bus_$display_number"
[ "$AT_SPI_BUS_ADDRESS" = "$expected" ]
[ -S "$root/run/xenoteer/bus/at-spi/bus_$display_number" ] \
  || [ -n "${CONTAINER_TEST_ALLOW_MISSING_SOCKET:-}" ]

owner=$(gdbus call \
  --address "$DBUS_SESSION_BUS_ADDRESS" \
  --dest org.freedesktop.DBus \
  --object-path /org/freedesktop/DBus \
  --method org.freedesktop.DBus.NameHasOwner \
  org.a11y.Bus)
printf '%s\n' "$owner" | grep -Eq '^\(true,\)$'

address=$(gdbus call \
  --address "$DBUS_SESSION_BUS_ADDRESS" \
  --dest org.a11y.Bus \
  --object-path /org/a11y/bus \
  --method org.a11y.Bus.GetAddress)
printf '%s\n' "$address" | grep -Fq "$AT_SPI_BUS_ADDRESS"

for property in IsEnabled ScreenReaderEnabled; do
  status=$(gdbus call \
    --address "$DBUS_SESSION_BUS_ADDRESS" \
    --dest org.a11y.Bus \
    --object-path /org/a11y/bus \
    --method org.freedesktop.DBus.Properties.Get \
    org.a11y.Status "$property")
  printf '%s\n' "$status" | grep -Eq '^\(<true>,\)$'
done

gdbus call \
  --address "$AT_SPI_BUS_ADDRESS" \
  --dest org.a11y.atspi.Registry \
  --object-path /org/a11y/atspi/registry \
  --method org.a11y.atspi.Registry.GetRegisteredEvents \
  >/dev/null
