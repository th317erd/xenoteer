#!/bin/sh
# SPDX-License-Identifier: BUSL-1.1
set -eu

service=${1-}
child_status=${2-256}
child_signal=${3-0}
service_dir_argument=${4-}

case "$service" in
  atspi|critical-shutdown-coordinator|session-dbus|websockify|x0tigervnc|xenoteer-processd|xenoteerd|xfce|xvfb) ;;
  *)
    echo 'critical finish invoked for an invalid service' >&2
    exit 125
    ;;
esac

# A direct s6-svc -d sets wantedup=false, but a following -u can restore it
# before the finish hook reads supervision state. Require a root-created,
# single-use marker for the one critical service that the recovery acceptance
# gate deliberately cycles. Validate both path components before trusting the
# exception; malformed or replaceable markers fail closed as critical exits.
maintenance_invalid=0
maintenance_parent=/run/xenoteer/critical-maintenance
maintenance_marker=$maintenance_parent/$service
if [ "$service" = atspi ] \
  && { [ -e "$maintenance_marker" ] || [ -L "$maintenance_marker" ]; }; then
  parent_attributes=$(stat -c '%u:%g:%a' -- "$maintenance_parent" 2>/dev/null) \
    || parent_attributes=invalid
  marker_attributes=$(stat -c '%u:%g:%a' -- "$maintenance_marker" 2>/dev/null) \
    || marker_attributes=invalid
  if [ -d "$maintenance_parent" ] \
    && [ ! -L "$maintenance_parent" ] \
    && [ "$parent_attributes" = 0:0:700 ] \
    && [ -f "$maintenance_marker" ] \
    && [ ! -L "$maintenance_marker" ] \
    && [ "$marker_attributes" = 0:0:600 ]; then
    rm -f -- "$maintenance_marker"
    exit 0
  fi
  maintenance_invalid=1
  echo 'invalid AT-SPI critical maintenance marker; failing closed' >&2
fi

# s6-rc clears wantedup before signalling a service during every requested
# graph teardown, including a Docker stop while the upward transaction is still
# in flight. An unsolicited child exit remains wanted-up. The AT-SPI
# maintenance exception above is deliberately checked first because a direct
# s6-svc cycle can still appear wanted-up on supported s6-overlay releases.
# Query `.` because s6-supervise invokes finish from the live service directory;
# the supplied directory name can be relative to its parent scan directory.
wanted_up=invalid
if [ "$maintenance_invalid" -eq 0 ] && [ -n "$service_dir_argument" ]; then
  wanted_up=$(/command/s6-svstat -o wantedup . 2>/dev/null) || wanted_up=invalid
fi
case "$wanted_up" in
  false) exit 125 ;;
  true) ;;
  *)
    echo 'unable to read critical supervision intent; failing closed' >&2
    ;;
esac

case "$child_status" in
  ''|*[!0-9]*) result=1 ;;
  0) result=1 ;;
  256)
    case "$child_signal" in
      ''|*[!0-9]*|0) result=1 ;;
      *)
        if [ "$child_signal" -le 127 ]; then
          result=$((128 + child_signal))
        else
          result=1
        fi
        ;;
    esac
    ;;
  *)
    if [ "$child_status" -le 255 ]; then
      result=$child_status
    else
      result=1
    fi
    ;;
esac

result_dir=/run/s6-linux-init-container-results
result_file=$result_dir/exitcode
claim_dir=/run/xenoteer/critical-shutdown-claimed

# Several critical services can fail as fallout from the same X11 or D-Bus
# loss. Preserve the first failure as the container result and send exactly one
# shutdown request. A directory creation is the only portable atomic primitive
# needed here and /run is private to this container lifetime.
if ! mkdir -- "$claim_dir" 2>/dev/null; then
  if [ -d "$claim_dir" ]; then
    exit 125
  fi
  echo 'unable to claim critical container shutdown; failing closed' >&2
fi

temporary="$result_dir/.xenoteer-exitcode.$$"
trap 'rm -f -- "$temporary"' EXIT HUP INT TERM
umask 022
if printf '%s\n' "$result" >"$temporary" \
  && chmod 0644 "$temporary" \
  && mv -f -- "$temporary" "$result_file"; then
  trap - EXIT HUP INT TERM
else
  echo 'failed to atomically record critical container exit result' >&2
  rm -f -- "$temporary"
  printf '%s\n' 1 >"$result_file" 2>/dev/null || :
  trap - EXIT HUP INT TERM
fi

printf 'critical service %s exited unexpectedly; container exit result %s\n' \
  "$service" "$result" >&2

# The coordinator cannot process its own failure. Its unexpected exit is the
# one exceptional path that terminates the supervision tree directly after the
# result has been recorded.
if [ "$service" = critical-shutdown-coordinator ]; then
  if ! /command/s6-svscanctl -t /run/service; then
    echo 'failed to terminate supervision tree after shutdown coordinator exit' >&2
  fi
  exit 125
fi

# Publish one request only after the exit result is durable. The root-only FIFO
# is opened by the dedicated supervised coordinator before it advertises
# readiness. Bound the write in case the coordinator disappears in the narrow
# interval between readiness and this finish hook.
request_fifo=/run/xenoteer/critical-shutdown-request
# The inner shell expands its positional parameters after timeout starts it.
# shellcheck disable=SC2016
if ! /usr/bin/timeout --signal=KILL 2 /bin/sh -c \
  'printf "%s\n" "$1" >"$2"' sh "$service" "$request_fifo"; then
  echo 'failed to publish critical shutdown request; terminating supervision tree' >&2
  /command/s6-svscanctl -t /run/service 2>/dev/null || :
fi

# s6-supervise reserves 125 for permanent failure. Never allow the longrun to
# respawn while the supervised coordinator handles the request.
exit 125
