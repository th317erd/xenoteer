{
  "$defs": {
    "DesktopGeneration": {
      "description": "Identifies one X server/session lifetime.",
      "format": "uuid",
      "type": "string"
    },
    "DesktopId": {
      "description": "Identifies a desktop resource.",
      "format": "uuid",
      "type": "string"
    },
    "LaunchId": {
      "description": "Identifies one managed application launch.",
      "format": "uuid",
      "type": "string"
    },
    "ProcessRef": {
      "additionalProperties": false,
      "description": "Request-direction representation of [`ProcessRef`].\n\nThe public reference is also emitted in responses and therefore accepts\nadditive output fields. Every request occurrence deserializes through this\nclosed shape so a misspelled identity claim is never ignored.",
      "properties": {
        "desktop_generation": {
          "$ref": "#/$defs/DesktopGeneration"
        },
        "launch_id": {
          "$ref": "#/$defs/LaunchId"
        },
        "pid": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "proc_start_ticks": {
          "format": "uint64-string",
          "maxLength": 20,
          "minLength": 1,
          "pattern": "^[1-9][0-9]{0,19}$",
          "type": "string"
        }
      },
      "required": [
        "desktop_generation",
        "pid",
        "proc_start_ticks",
        "launch_id"
      ],
      "type": "object"
    },
    "WindowAtomName": {
      "description": "Bounded escaped X11 atom name safe for public metadata.",
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "WindowIdentityHash": {
      "description": "Fixed lowercase SHA-256 projection binding an XID birth to initial evidence.",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "WindowMapState": {
      "description": "X server map/viewability state without guessing minimization semantics.",
      "oneOf": [
        {
          "const": "unmapped",
          "description": "The client is not mapped.",
          "type": "string"
        },
        {
          "const": "unviewable",
          "description": "The client is mapped but not currently viewable.",
          "type": "string"
        },
        {
          "const": "viewable",
          "description": "The client is mapped and viewable.",
          "type": "string"
        }
      ]
    },
    "WindowModelRevision": {
      "description": "One non-zero actor-local model revision.",
      "format": "uint64-string",
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^[1-9][0-9]{0,19}$",
      "type": "string"
    },
    "WindowOrder": {
      "description": "Stable ordering applied before limit/cursor projection.",
      "oneOf": [
        {
          "const": "creation_ascending",
          "description": "First-observed revision, then exact window-birth identity.",
          "type": "string"
        },
        {
          "const": "creation_descending",
          "description": "Reverse first-observed revision, then exact window-birth identity.",
          "type": "string"
        },
        {
          "const": "stacking_bottom_to_top",
          "description": "Observed stacking index with unlisted windows last, then birth identity.",
          "type": "string"
        },
        {
          "const": "stacking_top_to_bottom",
          "description": "Reverse observed stacking index with unlisted windows last, then birth identity.",
          "type": "string"
        },
        {
          "const": "title_ascending",
          "description": "Unicode scalar-value title order; missing titles last, then birth identity.",
          "type": "string"
        },
        {
          "const": "title_descending",
          "description": "Reverse Unicode scalar-value title order; missing titles last, then birth identity.",
          "type": "string"
        },
        {
          "const": "xid_ascending",
          "description": "Numeric XID, then observed generation and identity hash.",
          "type": "string"
        }
      ]
    },
    "WindowPredicate": {
      "description": "One safe leaf predicate over the bounded window model.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "field": {
              "$ref": "#/$defs/WindowTextField"
            },
            "matcher": {
              "$ref": "#/$defs/WindowStringMatch"
            },
            "type": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "type",
            "field",
            "matcher"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "process": {
              "$ref": "#/$defs/ProcessRef"
            },
            "type": {
              "const": "managed_process",
              "type": "string"
            }
          },
          "required": [
            "type",
            "process"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "pid": {
              "format": "uint32",
              "minimum": 1,
              "type": "integer"
            },
            "type": {
              "const": "reported_pid",
              "type": "string"
            }
          },
          "required": [
            "type",
            "pid"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "window_type",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/WindowAtomName"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "present": {
              "type": "boolean"
            },
            "type": {
              "const": "state",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/WindowAtomName"
            }
          },
          "required": [
            "type",
            "value",
            "present"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "map_state",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/WindowMapState"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "workspace",
              "type": "string"
            },
            "workspace": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "workspace"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "active",
              "type": "string"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "focused",
              "type": "string"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "transient_for",
              "type": "string"
            },
            "window": {
              "$ref": "#/$defs/WindowRef"
            }
          },
          "required": [
            "type",
            "window"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "group_leader",
              "type": "string"
            },
            "window": {
              "$ref": "#/$defs/WindowRef"
            }
          },
          "required": [
            "type",
            "window"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "has_accessibility_application",
              "type": "string"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "model_revision": {
              "$ref": "#/$defs/WindowModelRevision"
            },
            "type": {
              "const": "created_after",
              "type": "string"
            }
          },
          "required": [
            "type",
            "model_revision"
          ],
          "type": "object"
        }
      ]
    },
    "WindowRef": {
      "additionalProperties": false,
      "description": "Closed request-direction representation of [`WindowRef`].",
      "properties": {
        "desktop_generation": {
          "$ref": "#/$defs/DesktopGeneration"
        },
        "desktop_id": {
          "$ref": "#/$defs/DesktopId"
        },
        "identity_hash": {
          "$ref": "#/$defs/WindowIdentityHash"
        },
        "observed_generation": {
          "format": "uint64-string",
          "maxLength": 20,
          "minLength": 1,
          "pattern": "^[1-9][0-9]{0,19}$",
          "type": "string"
        },
        "xid": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "desktop_id",
        "desktop_generation",
        "xid",
        "observed_generation",
        "identity_hash"
      ],
      "type": "object"
    },
    "WindowSelector": {
      "description": "Recursively composed selector with explicit depth/node/predicate budgets.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "predicate": {
              "$ref": "#/$defs/WindowPredicate"
            },
            "type": {
              "const": "predicate",
              "type": "string"
            }
          },
          "required": [
            "type",
            "predicate"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "selectors": {
              "items": {
                "$ref": "#/$defs/WindowSelector"
              },
              "maxItems": 128,
              "minItems": 1,
              "type": "array"
            },
            "type": {
              "const": "all",
              "type": "string"
            }
          },
          "required": [
            "type",
            "selectors"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "selectors": {
              "items": {
                "$ref": "#/$defs/WindowSelector"
              },
              "maxItems": 128,
              "minItems": 1,
              "type": "array"
            },
            "type": {
              "const": "any",
              "type": "string"
            }
          },
          "required": [
            "type",
            "selectors"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "selector": {
              "$ref": "#/$defs/WindowSelector"
            },
            "type": {
              "const": "not",
              "type": "string"
            }
          },
          "required": [
            "type",
            "selector"
          ],
          "type": "object"
        }
      ]
    },
    "WindowSingleMatchPolicy": {
      "description": "Explicit single-target selector policy; ambiguity never silently picks a window.",
      "oneOf": [
        {
          "enum": [
            "exactly_one"
          ],
          "type": "string"
        },
        {
          "const": "first",
          "description": "Deterministic first result under the request's explicit `order`.",
          "type": "string"
        }
      ]
    },
    "WindowStringMatch": {
      "description": "Bounded locale-independent match expression.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "case_sensitive": {
              "type": "boolean"
            },
            "type": {
              "const": "exact",
              "type": "string"
            },
            "value": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "type",
            "value",
            "case_sensitive"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "case_sensitive": {
              "type": "boolean"
            },
            "type": {
              "const": "contains",
              "type": "string"
            },
            "value": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "type",
            "value",
            "case_sensitive"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "case_sensitive": {
              "type": "boolean"
            },
            "type": {
              "const": "prefix",
              "type": "string"
            },
            "value": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "type",
            "value",
            "case_sensitive"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "case_sensitive": {
              "type": "boolean"
            },
            "type": {
              "const": "suffix",
              "type": "string"
            },
            "value": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "type",
            "value",
            "case_sensitive"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Pattern compiled only by the bounded linear-time selector backend.",
          "properties": {
            "case_sensitive": {
              "type": "boolean"
            },
            "pattern": {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            "type": {
              "const": "regex",
              "type": "string"
            }
          },
          "required": [
            "type",
            "pattern",
            "case_sensitive"
          ],
          "type": "object"
        }
      ]
    },
    "WindowTextField": {
      "description": "Observed text field selected by a string matcher.",
      "enum": [
        "title",
        "visible_title",
        "icon_title",
        "class_instance",
        "class",
        "client_machine"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Safely resolves a selector to one stable reference before a later command.",
  "properties": {
    "desktop_generation": {
      "$ref": "#/$defs/DesktopGeneration"
    },
    "desktop_id": {
      "$ref": "#/$defs/DesktopId"
    },
    "match_policy": {
      "$ref": "#/$defs/WindowSingleMatchPolicy"
    },
    "order": {
      "$ref": "#/$defs/WindowOrder"
    },
    "selector": {
      "$ref": "#/$defs/WindowSelector"
    }
  },
  "required": [
    "desktop_id",
    "desktop_generation",
    "selector",
    "order",
    "match_policy"
  ],
  "title": "WindowResolveRequest",
  "type": "object"
}
