{
  "$defs": {
    "CommandId": {
      "description": "Deduplicates one client-authored command.",
      "format": "uuid",
      "type": "string"
    },
    "CommandLifecycle": {
      "description": "Lifecycle state of one deduplicated command execution.\n\nDeadline lifecycle wire names remain `deadline_before_effect` and\n`deadline_after_effect`; problem error codes use the fuller\n`deadline_exceeded_*` catalog names.",
      "oneOf": [
        {
          "const": "accepted",
          "description": "Admitted to the result ledger but not yet executing.",
          "type": "string"
        },
        {
          "const": "running",
          "description": "Currently executing.",
          "type": "string"
        },
        {
          "const": "succeeded",
          "description": "Completed successfully.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Completed with a non-cancellation failure.",
          "type": "string"
        },
        {
          "const": "cancelled_before_effect",
          "description": "Cancelled without an externally visible effect.",
          "type": "string"
        },
        {
          "const": "cancelled_after_effect",
          "description": "Cancelled after an externally visible effect.",
          "type": "string"
        },
        {
          "const": "deadline_before_effect",
          "description": "Deadline elapsed without an externally visible effect.",
          "type": "string"
        },
        {
          "const": "deadline_after_effect",
          "description": "Deadline elapsed after an externally visible effect.",
          "type": "string"
        }
      ]
    },
    "CommandOutcome": {
      "description": "A successful command payload.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A Phase-0 backend probe acknowledgment.",
          "properties": {
            "ready": {
              "description": "Whether the probed capability was ready at execution time.",
              "type": "boolean"
            },
            "type": {
              "const": "probe",
              "type": "string"
            }
          },
          "required": [
            "type",
            "ready"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A registered application profile launched successfully.",
          "properties": {
            "process": {
              "$ref": "#/$defs/ProcessRef",
              "description": "PID-reuse-safe managed process identity."
            },
            "type": {
              "const": "application_launched",
              "type": "string"
            }
          },
          "required": [
            "type",
            "process"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Current managed process status.",
          "properties": {
            "process": {
              "$ref": "#/$defs/ProcessView",
              "description": "Validated process status snapshot."
            },
            "type": {
              "const": "process_status",
              "type": "string"
            }
          },
          "required": [
            "type",
            "process"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Managed termination completed and the child was reaped.",
          "properties": {
            "process": {
              "$ref": "#/$defs/ProcessView",
              "description": "Terminal process status snapshot."
            },
            "type": {
              "const": "process_terminated",
              "type": "string"
            }
          },
          "required": [
            "type",
            "process"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An operation completed without an additional payload.",
          "properties": {
            "type": {
              "const": "acknowledged",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "CommandResult": {
      "description": "State and terminal payload for one command identifier.",
      "properties": {
        "accepted_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "command_id": {
          "$ref": "#/$defs/CommandId"
        },
        "effect_stage": {
          "$ref": "#/$defs/EffectStage"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Problem"
            },
            {
              "type": "null"
            }
          ]
        },
        "finished_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "lifecycle": {
          "$ref": "#/$defs/CommandLifecycle"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommandOutcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "started_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/Warning"
          },
          "maxItems": 16,
          "type": "array"
        }
      },
      "required": [
        "command_id",
        "lifecycle",
        "effect_stage",
        "accepted_at",
        "warnings"
      ],
      "type": "object"
    },
    "ConnectionId": {
      "description": "Identifies one WebSocket connection lifetime.",
      "format": "uuid",
      "type": "string"
    },
    "ControlLeaseId": {
      "description": "Identifies the current physical-input lease.",
      "format": "uuid",
      "type": "string"
    },
    "DesktopGeneration": {
      "description": "Identifies one X server/session lifetime.",
      "format": "uuid",
      "type": "string"
    },
    "DesktopId": {
      "description": "Identifies a desktop resource.",
      "format": "uuid",
      "type": "string"
    },
    "EffectStage": {
      "description": "Last externally visible stage reached by a command.",
      "oneOf": [
        {
          "const": "none",
          "description": "No effect occurred.",
          "type": "string"
        },
        {
          "const": "accepted",
          "description": "The command was admitted but has not touched the target.",
          "type": "string"
        },
        {
          "const": "outcome_unknown",
          "description": "Transport dispatch began, but the server cannot prove whether a target\neffect occurred. Clients must not create fresh work automatically.",
          "type": "string"
        },
        {
          "const": "side_effect_observed",
          "description": "A side effect occurred but the failing backend could not safely prove a\nmore specific stage. Clients must treat automatic retry as unsafe.",
          "type": "string"
        },
        {
          "const": "pointer_moved",
          "description": "The pointer moved.",
          "type": "string"
        },
        {
          "const": "button_pressed",
          "description": "A pointer button was pressed.",
          "type": "string"
        },
        {
          "const": "button_released",
          "description": "A pointer button was released.",
          "type": "string"
        },
        {
          "const": "key_pressed",
          "description": "A physical key was pressed.",
          "type": "string"
        },
        {
          "const": "key_released",
          "description": "A physical key was released.",
          "type": "string"
        },
        {
          "const": "input_reset",
          "description": "Xenoteer-owned pressed input was conservatively reset.",
          "type": "string"
        },
        {
          "const": "process_started",
          "description": "A managed application child was started.",
          "type": "string"
        },
        {
          "const": "process_signalled",
          "description": "A managed process group received a termination signal.",
          "type": "string"
        },
        {
          "const": "process_exited",
          "description": "A managed child was awaited and reaped.",
          "type": "string"
        },
        {
          "const": "postcondition_met",
          "description": "The requested postcondition was observed.",
          "type": "string"
        }
      ]
    },
    "ErrorCode": {
      "description": "A stable machine-readable error code.",
      "oneOf": [
        {
          "const": "invalid_request",
          "description": "Request syntax or shape is invalid.",
          "type": "string"
        },
        {
          "const": "unsupported_version",
          "description": "Protocol version negotiation failed.",
          "type": "string"
        },
        {
          "const": "authentication_required",
          "description": "Authentication is missing or invalid.",
          "type": "string"
        },
        {
          "const": "permission_denied",
          "description": "The principal lacks required authority.",
          "type": "string"
        },
        {
          "const": "not_found",
          "description": "A referenced resource does not exist.",
          "type": "string"
        },
        {
          "const": "stale_reference",
          "description": "A reference points at an earlier generation or identity.",
          "type": "string"
        },
        {
          "const": "command_id_conflict",
          "description": "A command identifier was reused with different content.",
          "type": "string"
        },
        {
          "const": "lease_conflict",
          "description": "The controller lease is absent or conflicts.",
          "type": "string"
        },
        {
          "const": "resource_exhausted",
          "description": "A bounded queue or quota is exhausted.",
          "type": "string"
        },
        {
          "const": "capability_unavailable",
          "description": "A required capability is not ready.",
          "type": "string"
        },
        {
          "const": "unsupported_by_target",
          "description": "The target cannot perform this operation.",
          "type": "string"
        },
        {
          "const": "deadline_exceeded_before_effect",
          "description": "Work exceeded its deadline before any effect.",
          "type": "string"
        },
        {
          "const": "deadline_exceeded_after_effect",
          "description": "Work exceeded its deadline after a partial effect.",
          "type": "string"
        },
        {
          "const": "request_outcome_unknown",
          "description": "A transport deadline elapsed after dispatch, so the request outcome\ncannot be proven from the response channel.",
          "type": "string"
        },
        {
          "const": "cancelled_before_effect",
          "description": "Work was cancelled before any effect.",
          "type": "string"
        },
        {
          "const": "cancelled_after_effect",
          "description": "Work was cancelled after a partial effect.",
          "type": "string"
        },
        {
          "const": "backend_failure",
          "description": "An external backend failed.",
          "type": "string"
        },
        {
          "const": "internal",
          "description": "A server invariant failed. Details remain opaque to clients.",
          "type": "string"
        }
      ]
    },
    "EventResumeStatus": {
      "description": "Resume disposition advertised by `server.welcome`.",
      "enum": [
        "replayed",
        "resync_required",
        "not_requested"
      ],
      "type": "string"
    },
    "EventResyncReason": {
      "description": "Why a client must refresh authoritative snapshots.",
      "enum": [
        "generation_changed",
        "history_lost",
        "sequence_ahead",
        "subscriber_lag",
        "outbound_backpressure"
      ],
      "type": "string"
    },
    "EventTopic": {
      "description": "A stable, bounded event topic assigned before subscriber filtering.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "type": "string"
    },
    "LaunchId": {
      "description": "Identifies one managed application launch.",
      "format": "uuid",
      "type": "string"
    },
    "LeaseAvailability": {
      "description": "Public lease availability without another principal's identity or token.",
      "oneOf": [
        {
          "const": "vacant",
          "description": "No lease/reset transaction exists.",
          "type": "string"
        },
        {
          "const": "held_by_caller",
          "description": "The authenticated caller owns the active lease.",
          "type": "string"
        },
        {
          "const": "occupied",
          "description": "Another principal owns the active lease.",
          "type": "string"
        },
        {
          "const": "revoking",
          "description": "Admission has stopped and cleanup has not started.",
          "type": "string"
        },
        {
          "const": "resetting",
          "description": "Owned-input cleanup is in progress.",
          "type": "string"
        }
      ]
    },
    "LeaseStateView": {
      "additionalProperties": false,
      "description": "A redaction-safe lease state response.",
      "properties": {
        "desktop_generation": {
          "$ref": "#/$defs/DesktopGeneration",
          "description": "Authoritative desktop lifetime."
        },
        "desktop_id": {
          "$ref": "#/$defs/DesktopId",
          "description": "Target desktop."
        },
        "expires_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "Active expiry; safe occupied views may disclose this without identity."
        },
        "lease_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ControlLeaseId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Lease ID only when the authenticated caller owns it."
        },
        "state": {
          "$ref": "#/$defs/LeaseAvailability",
          "description": "Public availability phase."
        }
      },
      "required": [
        "desktop_id",
        "desktop_generation",
        "state"
      ],
      "type": "object"
    },
    "Problem": {
      "description": "RFC 9457-shaped safe problem details.\n\nJSON Schema string lengths count Unicode code points; admission additionally\nenforces the exported UTF-8 byte ceilings.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "desktop_generation": {
          "anyOf": [
            {
              "$ref": "#/$defs/DesktopGeneration"
            },
            {
              "type": "null"
            }
          ]
        },
        "detail": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "maxProperties": 16,
          "propertyNames": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9._-]+$"
          },
          "type": "object"
        },
        "effect_stage": {
          "$ref": "#/$defs/EffectStage"
        },
        "instance": {
          "maxLength": 256,
          "type": [
            "string",
            "null"
          ]
        },
        "retry": {
          "$ref": "#/$defs/RetryAdvice"
        },
        "status": {
          "format": "uint16",
          "maximum": 599,
          "minimum": 400,
          "type": "integer"
        },
        "title": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "type",
        "title",
        "status",
        "code",
        "detail",
        "retry",
        "effect_stage",
        "details"
      ],
      "type": "object"
    },
    "ProcessExit": {
      "additionalProperties": false,
      "description": "Reaped Unix child status without unbounded output.",
      "properties": {
        "code": {
          "description": "Normal exit status, mutually exclusive with `signal`.",
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "core_dumped": {
          "description": "Whether the OS reported a core dump.",
          "type": "boolean"
        },
        "signal": {
          "description": "Terminating signal, mutually exclusive with `code`.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "core_dumped"
      ],
      "type": "object"
    },
    "ProcessRef": {
      "additionalProperties": false,
      "description": "A reference safe against desktop restart and Linux PID reuse.",
      "properties": {
        "desktop_generation": {
          "$ref": "#/$defs/DesktopGeneration",
          "description": "Desktop lifetime that owns the child."
        },
        "launch_id": {
          "$ref": "#/$defs/LaunchId",
          "description": "Server-generated managed launch identity."
        },
        "pid": {
          "description": "Positive Linux process identifier.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "proc_start_ticks": {
          "description": "Field 22 from `/proc/{pid}/stat`, measured in boot clock ticks.",
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "desktop_generation",
        "pid",
        "proc_start_ticks",
        "launch_id"
      ],
      "type": "object"
    },
    "ProcessState": {
      "description": "Coarse managed child lifecycle.",
      "oneOf": [
        {
          "const": "starting",
          "description": "Spawn is admitted but exec identity is not yet published.",
          "type": "string"
        },
        {
          "const": "running",
          "description": "The verified child/process group is running.",
          "type": "string"
        },
        {
          "const": "terminating",
          "description": "SIGTERM/SIGKILL termination is in progress.",
          "type": "string"
        },
        {
          "const": "exited",
          "description": "The child was awaited and reaped.",
          "type": "string"
        }
      ]
    },
    "ProcessView": {
      "additionalProperties": false,
      "description": "Current status of a managed application child.",
      "properties": {
        "exit": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProcessExit"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exit details present exactly when `state` is `exited`."
        },
        "process": {
          "$ref": "#/$defs/ProcessRef",
          "description": "Exact process reference."
        },
        "state": {
          "$ref": "#/$defs/ProcessState",
          "description": "Current managed lifecycle."
        }
      },
      "required": [
        "process",
        "state"
      ],
      "type": "object"
    },
    "ProtocolVersion": {
      "additionalProperties": false,
      "description": "A negotiated protocol major/minor pair.",
      "properties": {
        "major": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "minor": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "major",
        "minor"
      ],
      "type": "object"
    },
    "RequestId": {
      "description": "Correlates one transport request and response.",
      "format": "uuid",
      "type": "string"
    },
    "RetryAdvice": {
      "description": "Client retry guidance attached to a failure.",
      "oneOf": [
        {
          "const": "never",
          "description": "Repeating the operation is unsafe or cannot change the result.",
          "type": "string"
        },
        {
          "const": "same_command_id",
          "description": "Retrieve or resubmit the exact request with the same command identifier.",
          "type": "string"
        },
        {
          "const": "after_resync",
          "description": "Refresh generation-bound state before creating a new command.",
          "type": "string"
        },
        {
          "const": "after_backoff",
          "description": "No effect occurred; a new command may be attempted after delay.",
          "type": "string"
        }
      ]
    },
    "SequencedEvent": {
      "description": "One normalized event after global sequence assignment.",
      "properties": {
        "desktop_generation": {
          "$ref": "#/$defs/DesktopGeneration"
        },
        "desktop_id": {
          "$ref": "#/$defs/DesktopId"
        },
        "payload": {
          "description": "Bounded, topic-specific, safe JSON data."
        },
        "sequence": {
          "description": "Global sequence assigned before subscriber filtering.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "topic": {
          "$ref": "#/$defs/EventTopic"
        }
      },
      "required": [
        "desktop_id",
        "desktop_generation",
        "sequence",
        "topic",
        "payload"
      ],
      "type": "object"
    },
    "Timestamp": {
      "description": "A canonical RFC 3339 timestamp with an explicit UTC offset.",
      "format": "date-time",
      "type": "string"
    },
    "Warning": {
      "description": "A bounded safe warning returned with a result.\n\nJSON Schema string lengths count Unicode code points; admission additionally\nenforces the public UTF-8 byte ceilings.",
      "properties": {
        "code": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9._-]+$",
          "type": "string"
        },
        "message": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "WelcomeDesktop": {
      "description": "Current desktop summary in `server.welcome`.",
      "properties": {
        "generation": {
          "anyOf": [
            {
              "$ref": "#/$defs/DesktopGeneration"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "$ref": "#/$defs/DesktopId"
        },
        "state": {
          "$ref": "#/$defs/WelcomeDesktopState"
        }
      },
      "required": [
        "id",
        "state"
      ],
      "type": "object"
    },
    "WelcomeDesktopState": {
      "description": "Coarse desktop state embedded in `server.welcome`.",
      "enum": [
        "booting",
        "probing",
        "ready",
        "degraded",
        "draining",
        "stopped",
        "failed"
      ],
      "type": "string"
    },
    "WelcomeLimits": {
      "description": "Advertised connection-specific bounds in `server.welcome`.",
      "properties": {
        "heartbeat_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "max_command_watches": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "max_message_bytes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "normal_outbound_capacity": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "reserved_outbound_capacity": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max_message_bytes",
        "heartbeat_ms",
        "normal_outbound_capacity",
        "reserved_outbound_capacity",
        "max_command_watches"
      ],
      "type": "object"
    },
    "WelcomePrincipal": {
      "description": "Authenticated identity summary in `server.welcome`.",
      "properties": {
        "capabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "capabilities"
      ],
      "type": "object"
    },
    "WelcomeResume": {
      "description": "Retained-resume status in `server.welcome`.",
      "properties": {
        "status": {
          "$ref": "#/$defs/EventResumeStatus"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Server WebSocket application messages.\n\nUnlike client inputs, decoders should tolerate additive fields from newer\nminor protocol versions, so this output enum intentionally omits\n`deny_unknown_fields`.",
  "oneOf": [
    {
      "properties": {
        "connection_id": {
          "$ref": "#/$defs/ConnectionId"
        },
        "desktop": {
          "$ref": "#/$defs/WelcomeDesktop"
        },
        "limits": {
          "$ref": "#/$defs/WelcomeLimits"
        },
        "principal": {
          "$ref": "#/$defs/WelcomePrincipal"
        },
        "protocol": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "resume": {
          "$ref": "#/$defs/WelcomeResume"
        },
        "type": {
          "const": "server.welcome",
          "type": "string"
        }
      },
      "required": [
        "type",
        "protocol",
        "connection_id",
        "principal",
        "desktop",
        "limits",
        "resume"
      ],
      "type": "object"
    },
    {
      "properties": {
        "nonce": {
          "type": "string"
        },
