{
  "$defs": {
    "AccessibilityIdentityHash": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "AtspiBusName": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "AtspiGeneration": {
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "AtspiObjectPath": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "DesktopGeneration": {
      "description": "Identifies one X server/session lifetime.",
      "format": "uuid",
      "type": "string"
    },
    "DesktopId": {
      "description": "Identifies a desktop resource.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "app_instance_generation": {
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "atspi_generation": {
      "$ref": "#/$defs/AtspiGeneration"
    },
    "desktop_generation": {
      "$ref": "#/$defs/DesktopGeneration"
    },
    "desktop_id": {
      "$ref": "#/$defs/DesktopId"
    },
    "identity_hash": {
      "$ref": "#/$defs/AccessibilityIdentityHash"
    },
    "root_object_path": {
      "$ref": "#/$defs/AtspiObjectPath"
    },
    "unique_bus_name": {
      "$ref": "#/$defs/AtspiBusName"
    }
  },
  "required": [
    "desktop_id",
    "desktop_generation",
    "atspi_generation",
    "unique_bus_name",
    "root_object_path",
    "app_instance_generation",
    "identity_hash"
  ],
  "title": "ApplicationRef",
  "type": "object"
}
