{
  "$defs": {
    "DesktopGeneration": {
      "description": "Identifies one X server/session lifetime.",
      "format": "uuid",
      "type": "string"
    },
    "EffectStage": {
      "description": "Last externally visible stage reached by a command.",
      "oneOf": [
        {
          "const": "none",
          "description": "No effect occurred.",
          "type": "string"
        },
        {
          "const": "accepted",
          "description": "The command was admitted but has not touched the target.",
          "type": "string"
        },
        {
          "const": "outcome_unknown",
          "description": "Transport dispatch began, but the server cannot prove whether a target\neffect occurred. Clients must not create fresh work automatically.",
          "type": "string"
        },
        {
          "const": "side_effect_observed",
          "description": "A side effect occurred but the failing backend could not safely prove a\nmore specific stage. Clients must treat automatic retry as unsafe.",
          "type": "string"
        },
        {
          "const": "pointer_moved",
          "description": "The pointer moved.",
          "type": "string"
        },
        {
          "const": "button_pressed",
          "description": "A pointer button was pressed.",
          "type": "string"
        },
        {
          "const": "button_released",
          "description": "A pointer button was released.",
          "type": "string"
        },
        {
          "const": "pointer_clicked",
          "description": "One or more complete pointer clicks were confirmed.",
          "type": "string"
        },
        {
          "const": "pointer_dragged",
          "description": "A complete press/move/release drag was confirmed.",
          "type": "string"
        },
        {
          "const": "pointer_scrolled",
          "description": "One or more complete discrete scroll notches were confirmed.",
          "type": "string"
        },
        {
          "const": "key_pressed",
          "description": "A physical key was pressed.",
          "type": "string"
        },
        {
          "const": "key_released",
          "description": "A physical key was released.",
          "type": "string"
        },
        {
          "const": "keyboard_action_completed",
          "description": "A complete key press, chord, or sequence was confirmed.",
          "type": "string"
        },
        {
          "const": "input_reset",
          "description": "Xenoteer-owned pressed input was conservatively reset.",
          "type": "string"
        },
        {
          "const": "process_started",
          "description": "A managed application child was started.",
          "type": "string"
        },
        {
          "const": "process_signalled",
          "description": "A managed process group received a termination signal.",
          "type": "string"
        },
        {
          "const": "process_exited",
          "description": "A managed child was awaited and reaped.",
          "type": "string"
        },
        {
          "const": "postcondition_met",
          "description": "The requested postcondition was observed.",
          "type": "string"
        },
        {
          "const": "window_request_sent",
          "description": "A window-manager or ICCCM request crossed its externally visible boundary.",
          "type": "string"
        },
        {
          "const": "window_state_changed",
          "description": "The requested window postcondition was observed.",
          "type": "string"
        },
        {
          "const": "clipboard_ownership_changed",
          "description": "Xenoteer acquired or relinquished X11 selection ownership.",
          "type": "string"
        },
        {
          "const": "text_inserted",
          "description": "At least one text-insertion effect was emitted.",
          "type": "string"
        },
        {
          "const": "semantic_action_dispatched",
          "description": "A semantic AT-SPI method crossed its externally visible dispatch boundary.",
          "type": "string"
        },
        {
          "const": "semantic_state_changed",
          "description": "A requested semantic state/readback was observed.",
          "type": "string"
        },
        {
          "const": "element_physically_clicked",
          "description": "A physical click derived from revalidated element geometry completed.",
          "type": "string"
        }
      ]
    },
    "ErrorCode": {
      "description": "A stable machine-readable error code.",
      "oneOf": [
        {
          "const": "invalid_request",
          "description": "Request syntax or shape is invalid.",
          "type": "string"
        },
        {
          "const": "unsupported_version",
          "description": "Protocol version negotiation failed.",
          "type": "string"
        },
        {
          "const": "authentication_required",
          "description": "Authentication is missing or invalid.",
          "type": "string"
        },
        {
          "const": "permission_denied",
          "description": "The principal lacks required authority.",
          "type": "string"
        },
        {
          "const": "not_found",
          "description": "A referenced resource does not exist.",
          "type": "string"
        },
        {
          "const": "stale_reference",
          "description": "A reference points at an earlier generation or identity.",
          "type": "string"
        },
        {
          "const": "command_id_conflict",
          "description": "A command identifier was reused with different content.",
          "type": "string"
        },
        {
          "const": "lease_conflict",
          "description": "The controller lease is absent or conflicts.",
          "type": "string"
        },
        {
          "const": "resource_exhausted",
          "description": "A bounded queue or quota is exhausted.",
          "type": "string"
        },
        {
          "const": "capability_unavailable",
          "description": "A required capability is not ready.",
          "type": "string"
        },
        {
          "const": "unsupported_by_target",
          "description": "The target cannot perform this operation.",
          "type": "string"
        },
        {
          "const": "application_not_accessible",
          "description": "The application is absent from or unreachable through AT-SPI.",
          "type": "string"
        },
        {
          "const": "element_not_found",
          "description": "The exact generation-fenced accessibility element no longer exists.",
          "type": "string"
        },
        {
          "const": "ambiguous_target",
          "description": "A selector that required one target matched more than one.",
          "type": "string"
        },
        {
          "const": "element_defunct",
          "description": "The referenced accessibility object reports or behaves as defunct.",
          "type": "string"
        },
        {
          "const": "interface_not_supported",
          "description": "The target does not expose the required AT-SPI interface.",
          "type": "string"
        },
        {
          "const": "element_not_showing",
          "description": "The element is not showing in the accessible hierarchy.",
          "type": "string"
        },
        {
          "const": "element_not_sensitive",
          "description": "The element is not sensitive/enabled for the requested action.",
          "type": "string"
        },
        {
          "const": "element_not_editable",
          "description": "The element is not editable through the required semantic interface.",
          "type": "string"
        },
        {
          "const": "action_not_found",
          "description": "The requested semantic action name or index is absent.",
          "type": "string"
        },
        {
          "const": "weak_window_correlation",
          "description": "Element-to-X11-window correlation is below the required confidence.",
          "type": "string"
        },
        {
          "const": "element_geometry_invalid",
          "description": "Accessible component geometry is missing, stale, or invalid.",
          "type": "string"
        },
        {
          "const": "element_occluded",
          "description": "Occlusion policy rejected the resolved element click point.",
          "type": "string"
        },
        {
          "const": "query_budget_exceeded",
          "description": "Accessibility traversal exhausted its declared query budget.",
          "type": "string"
        },
        {
          "const": "snapshot_truncated",
          "description": "A complete requested accessibility snapshot could not fit its budget.",
          "type": "string"
        },
        {
          "const": "toolkit_protocol_error",
          "description": "The toolkit returned malformed or contradictory AT-SPI data.",
          "type": "string"
        },
        {
          "const": "semantic_postcondition_failed",
          "description": "The semantic effect completed but its required postcondition failed.",
          "type": "string"
        },
        {
          "const": "deadline_exceeded_before_effect",
          "description": "Work exceeded its deadline before any effect.",
          "type": "string"
        },
        {
          "const": "deadline_exceeded_after_effect",
          "description": "Work exceeded its deadline after a partial effect.",
          "type": "string"
        },
        {
          "const": "request_outcome_unknown",
          "description": "A transport deadline elapsed after dispatch, so the request outcome\ncannot be proven from the response channel.",
          "type": "string"
        },
        {
          "const": "cancelled_before_effect",
          "description": "Work was cancelled before any effect.",
          "type": "string"
        },
        {
          "const": "cancelled_after_effect",
          "description": "Work was cancelled after a partial effect.",
          "type": "string"
        },
        {
          "const": "backend_failure",
          "description": "An external backend failed.",
          "type": "string"
        },
        {
          "const": "internal",
          "description": "A server invariant failed. Details remain opaque to clients.",
          "type": "string"
        }
      ]
    },
    "RetryAdvice": {
      "description": "Client retry guidance attached to a failure.",
      "oneOf": [
        {
          "const": "never",
          "description": "Repeating the operation is unsafe or cannot change the result.",
          "type": "string"
        },
        {
          "const": "same_command_id",
          "description": "Retrieve or resubmit the exact request with the same command identifier.",
          "type": "string"
        },
        {
          "const": "after_resync",
          "description": "Refresh generation-bound state before creating a new command.",
          "type": "string"
        },
        {
          "const": "after_backoff",
          "description": "No effect occurred; a new command may be attempted after delay.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "RFC 9457-shaped safe problem details.\n\nJSON Schema string lengths count Unicode code points; admission additionally\nenforces the exported UTF-8 byte ceilings.",
  "properties": {
    "code": {
      "$ref": "#/$defs/ErrorCode"
    },
    "desktop_generation": {
      "anyOf": [
        {
          "$ref": "#/$defs/DesktopGeneration"
        },
        {
          "type": "null"
        }
      ]
    },
    "detail": {
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
    },
    "details": {
      "additionalProperties": true,
      "maxProperties": 16,
      "propertyNames": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[a-z0-9._-]+$"
      },
      "type": "object"
    },
    "effect_stage": {
      "$ref": "#/$defs/EffectStage"
    },
    "instance": {
      "maxLength": 256,
      "type": [
        "string",
        "null"
      ]
    },
    "retry": {
      "$ref": "#/$defs/RetryAdvice"
    },
    "status": {
      "format": "uint16",
      "maximum": 599,
      "minimum": 400,
      "type": "integer"
    },
    "title": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "type",
    "title",
    "status",
    "code",
    "detail",
    "retry",
    "effect_stage",
    "details"
  ],
  "title": "Problem",
  "type": "object"
}
