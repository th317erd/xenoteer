{
  "$defs": {
    "AccessibilityIdentityHash": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "ApplicationRef": {
      "properties": {
        "app_instance_generation": {
          "format": "uint64-string",
          "maxLength": 20,
          "minLength": 1,
          "pattern": "^[1-9][0-9]{0,19}$",
          "type": "string"
        },
        "atspi_generation": {
          "$ref": "#/$defs/AtspiGeneration"
        },
        "desktop_generation": {
          "$ref": "#/$defs/DesktopGeneration"
        },
        "desktop_id": {
          "$ref": "#/$defs/DesktopId"
        },
        "identity_hash": {
          "$ref": "#/$defs/AccessibilityIdentityHash"
        },
        "root_object_path": {
          "$ref": "#/$defs/AtspiObjectPath"
        },
        "unique_bus_name": {
          "$ref": "#/$defs/AtspiBusName"
        }
      },
      "required": [
        "desktop_id",
        "desktop_generation",
        "atspi_generation",
        "unique_bus_name",
        "root_object_path",
        "app_instance_generation",
        "identity_hash"
      ],
      "type": "object"
    },
    "AtspiBusName": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "AtspiGeneration": {
      "format": "uint64-string",
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^[1-9][0-9]{0,19}$",
      "type": "string"
    },
    "AtspiObjectPath": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "DesktopGeneration": {
      "description": "Identifies one X server/session lifetime.",
      "format": "uuid",
      "type": "string"
    },
    "DesktopId": {
      "description": "Identifies a desktop resource.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "application": {
      "$ref": "#/$defs/ApplicationRef"
    },
    "atspi_generation": {
      "$ref": "#/$defs/AtspiGeneration"
    },
    "cache_sequence": {
      "format": "uint64-string",
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^[1-9][0-9]{0,19}$",
      "type": "string"
    },
    "desktop_generation": {
      "$ref": "#/$defs/DesktopGeneration"
    },
    "desktop_id": {
      "$ref": "#/$defs/DesktopId"
    },
    "object_identity_hash": {
      "$ref": "#/$defs/AccessibilityIdentityHash"
    },
    "object_path": {
      "$ref": "#/$defs/AtspiObjectPath"
    }
  },
  "required": [
    "desktop_id",
    "desktop_generation",
    "atspi_generation",
    "application",
    "object_path",
    "object_identity_hash",
    "cache_sequence"
  ],
  "title": "ElementRef",
  "type": "object"
}
