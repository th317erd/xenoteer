{
  "$defs": {
    "DesktopGeneration": {
      "description": "Identifies one X server/session lifetime.",
      "format": "uuid",
      "type": "string"
    },
    "DesktopId": {
      "description": "Identifies a desktop resource.",
      "format": "uuid",
      "type": "string"
    },
    "Rect": {
      "additionalProperties": false,
      "description": "Closed request-direction rectangle object.",
      "properties": {
        "height": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "width": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "x": {
          "format": "int32",
          "type": "integer"
        },
        "y": {
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "type": "object"
    },
    "ScreenshotFormat": {
      "description": "Public screenshot representation.",
      "oneOf": [
        {
          "const": "png",
          "description": "Lossless PNG body.",
          "type": "string"
        },
        {
          "const": "raw_bgra",
          "description": "Tightly packed unpremultiplied BGRA8 body with explicit metadata.",
          "type": "string"
        }
      ]
    },
    "ScreenshotResizeFilter": {
      "description": "Closed deterministic resize-filter set.",
      "oneOf": [
        {
          "const": "nearest",
          "description": "Pixel replication for exact diagnostic fixtures.",
          "type": "string"
        },
        {
          "const": "lanczos",
          "description": "High-quality Lanczos3 convolution.",
          "type": "string"
        }
      ]
    },
    "ScreenshotScale": {
      "additionalProperties": false,
      "description": "Requested destination size. One omitted dimension preserves aspect ratio.",
      "properties": {
        "filter": {
          "$ref": "#/$defs/ScreenshotResizeFilter",
          "description": "Deterministic resampling algorithm."
        },
        "height": {
          "description": "Explicit output height, or aspect-derived height when omitted.",
          "format": "uint32",
          "maximum": 8192,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "width": {
          "description": "Explicit output width, or aspect-derived width when omitted.",
          "format": "uint32",
          "maximum": 8192,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "filter"
      ],
      "type": "object"
    },
    "ScreenshotTarget": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "root",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "coordinate_space": {
              "$ref": "#/$defs/WindowCaptureSpace"
            },
            "kind": {
              "const": "window_visible",
              "type": "string"
            },
            "window": {
              "$ref": "#/$defs/WindowRef"
            }
          },
          "required": [
            "kind",
            "window",
            "coordinate_space"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "window_drawable",
              "type": "string"
            },
            "window": {
              "$ref": "#/$defs/WindowRef"
            }
          },
          "required": [
            "kind",
            "window"
          ],
          "type": "object"
        }
      ]
    },
    "WindowCaptureSpace": {
      "description": "Window-relative space used to interpret a `window_visible` region.",
      "oneOf": [
        {
          "const": "client",
          "description": "Rectangle relative to the ICCCM client window.",
          "type": "string"
        },
        {
          "const": "frame",
          "description": "Rectangle relative to the window-manager frame, including decorations.",
          "type": "string"
        }
      ]
    },
    "WindowIdentityHash": {
      "description": "Fixed lowercase SHA-256 projection binding an XID birth to initial evidence.",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "WindowRef": {
      "additionalProperties": false,
      "description": "Closed request-direction representation of [`WindowRef`].",
      "properties": {
        "desktop_generation": {
          "$ref": "#/$defs/DesktopGeneration"
        },
        "desktop_id": {
          "$ref": "#/$defs/DesktopId"
        },
        "identity_hash": {
          "$ref": "#/$defs/WindowIdentityHash"
        },
        "observed_generation": {
          "format": "uint64-string",
          "maxLength": 20,
          "minLength": 1,
          "pattern": "^[1-9][0-9]{0,19}$",
          "type": "string"
        },
        "xid": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "desktop_id",
        "desktop_generation",
        "xid",
        "observed_generation",
        "identity_hash"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One bounded screenshot request.",
  "properties": {
    "format": {
      "$ref": "#/$defs/ScreenshotFormat",
      "description": "Output encoding."
    },
    "include_cursor": {
      "description": "Whether the XFIXES cursor is weak-snapshot composited into visible pixels.",
      "type": "boolean"
    },
    "max_bytes": {
      "description": "Caller-selected response ceiling, which may only tighten the server limit.",
      "format": "uint64",
      "maximum": 33554432,
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    },
    "region": {
      "anyOf": [
        {
          "$ref": "#/$defs/Rect"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional target-local crop. Root uses root-physical coordinates; window\ntargets use their declared client/frame coordinate space."
    },
    "scale": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScreenshotScale"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional resize applied after capture and cursor composition."
    },
    "target": {
      "$ref": "#/$defs/ScreenshotTarget",
      "description": "Pixel-source semantics."
    }
  },
  "required": [
    "target",
    "format",
    "include_cursor"
  ],
  "title": "ScreenshotRequest",
  "type": "object"
}
