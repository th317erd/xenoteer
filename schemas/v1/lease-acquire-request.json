{
  "$defs": {
    "DesktopGeneration": {
      "description": "Identifies one X server/session lifetime.",
      "format": "uuid",
      "type": "string"
    },
    "DesktopId": {
      "description": "Identifies a desktop resource.",
      "format": "uuid",
      "type": "string"
    },
    "ProtocolVersion": {
      "additionalProperties": false,
      "description": "Closed request-direction protocol-version object.",
      "properties": {
        "major": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "minor": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "major",
        "minor"
      ],
      "type": "object"
    },
    "RequestId": {
      "description": "Correlates one transport request and response.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A request to acquire exclusive physical-input control.",
  "properties": {
    "desktop_generation": {
      "$ref": "#/$defs/DesktopGeneration",
      "description": "Target desktop lifetime observed by the caller."
    },
    "desktop_id": {
      "$ref": "#/$defs/DesktopId",
      "description": "Target desktop."
    },
    "protocol_version": {
      "$ref": "#/$defs/ProtocolVersion",
      "description": "Requested protocol version."
    },
    "request_id": {
      "$ref": "#/$defs/RequestId",
      "description": "Transport request correlation identifier."
    },
    "ttl_ms": {
      "description": "Requested TTL; omission selects server policy.",
      "format": "uint32",
      "maximum": 3600000,
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "protocol_version",
    "request_id",
    "desktop_id",
    "desktop_generation"
  ],
  "title": "LeaseAcquireRequest",
  "type": "object"
}
