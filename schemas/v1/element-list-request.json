{
  "$defs": {
    "AccessibilityIdentityHash": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "AccessibilityPageCursor": {
      "description": "Opaque authenticated cursor into immutable actor-owned query state.\n\nThe server must bind each token to principal, desktop/AT-SPI generations,\nsnapshot revision, selector/scope, traversal order, and expansion. It must\nexpire state after [`ACCESSIBILITY_CURSOR_TTL_MS`] and enforce\n[`MAX_ACCESSIBILITY_CURSORS_PER_PRINCIPAL`]; clients cannot construct or\nextend cursor state from the token contents.",
      "maxLength": 1024,
      "minLength": 16,
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "AccessibilityQueryLimits": {
      "additionalProperties": false,
      "properties": {
        "max_depth": {
          "format": "uint16",
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        },
        "max_matches": {
          "format": "uint16",
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        "max_visited_nodes": {
          "format": "uint32",
          "maximum": 25000,
          "minimum": 1,
          "type": "integer"
        },
        "timeout_ms": {
          "format": "uint32",
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "max_visited_nodes",
        "max_depth",
        "max_matches",
        "timeout_ms"
      ],
      "type": "object"
    },
    "ApplicationRef": {
      "additionalProperties": false,
      "properties": {
        "app_instance_generation": {
          "format": "uint64-string",
          "maxLength": 20,
          "minLength": 1,
          "pattern": "^[1-9][0-9]{0,19}$",
          "type": "string"
        },
        "atspi_generation": {
          "$ref": "#/$defs/AtspiGeneration"
        },
        "desktop_generation": {
          "$ref": "#/$defs/DesktopGeneration"
        },
        "desktop_id": {
          "$ref": "#/$defs/DesktopId"
        },
        "identity_hash": {
          "$ref": "#/$defs/AccessibilityIdentityHash"
        },
        "root_object_path": {
          "$ref": "#/$defs/AtspiObjectPath"
        },
        "unique_bus_name": {
          "$ref": "#/$defs/AtspiBusName"
        }
      },
      "required": [
        "desktop_id",
        "desktop_generation",
        "atspi_generation",
        "unique_bus_name",
        "root_object_path",
        "app_instance_generation",
        "identity_hash"
      ],
      "type": "object"
    },
    "AtspiBusName": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "AtspiGeneration": {
      "format": "uint64-string",
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^[1-9][0-9]{0,19}$",
      "type": "string"
    },
    "AtspiObjectPath": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "DesktopGeneration": {
      "description": "Identifies one X server/session lifetime.",
      "format": "uuid",
      "type": "string"
    },
    "DesktopId": {
      "description": "Identifies a desktop resource.",
      "format": "uuid",
      "type": "string"
    },
    "ElementOrder": {
      "enum": [
        "preorder",
        "reverse_preorder",
        "name_ascending",
        "name_descending",
        "role_then_name",
        "object_path_ascending"
      ],
      "type": "string"
    },
    "ElementRef": {
      "additionalProperties": false,
      "properties": {
        "application": {
          "$ref": "#/$defs/ApplicationRef"
        },
        "atspi_generation": {
          "$ref": "#/$defs/AtspiGeneration"
        },
        "cache_sequence": {
          "format": "uint64-string",
          "maxLength": 20,
          "minLength": 1,
          "pattern": "^[1-9][0-9]{0,19}$",
          "type": "string"
        },
        "desktop_generation": {
          "$ref": "#/$defs/DesktopGeneration"
        },
        "desktop_id": {
          "$ref": "#/$defs/DesktopId"
        },
        "object_identity_hash": {
          "$ref": "#/$defs/AccessibilityIdentityHash"
        },
        "object_path": {
          "$ref": "#/$defs/AtspiObjectPath"
        }
      },
      "required": [
        "desktop_id",
        "desktop_generation",
        "atspi_generation",
        "application",
        "object_path",
        "object_identity_hash",
        "cache_sequence"
      ],
      "type": "object"
    },
    "ElementScope": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "desktop",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "application": {
              "$ref": "#/$defs/ApplicationRef"
            },
            "type": {
              "const": "application",
              "type": "string"
            }
          },
          "required": [
            "type",
            "application"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "window",
              "type": "string"
            },
            "window": {
              "$ref": "#/$defs/WindowRef"
            }
          },
          "required": [
            "type",
            "window"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "include_root": {
              "type": "boolean"
            },
            "root": {
              "$ref": "#/$defs/ElementRef"
            },
            "type": {
              "const": "subtree",
              "type": "string"
            }
          },
          "required": [
            "type",
            "root",
            "include_root"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "parent": {
              "$ref": "#/$defs/ElementRef"
            },
            "type": {
              "const": "children",
              "type": "string"
            }
          },
          "required": [
            "type",
            "parent"
          ],
          "type": "object"
        }
      ]
    },
    "ElementSnapshotExpansion": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "type": "boolean"
        },
        "text_metadata": {
          "type": "boolean"
        },
        "value": {
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "text_metadata",
        "component"
      ],
      "type": "object"
    },
    "WindowIdentityHash": {
      "description": "Fixed lowercase SHA-256 projection binding an XID birth to initial evidence.",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "WindowRef": {
      "additionalProperties": false,
      "description": "Closed request-direction representation of [`WindowRef`].",
      "properties": {
        "desktop_generation": {
          "$ref": "#/$defs/DesktopGeneration"
        },
        "desktop_id": {
          "$ref": "#/$defs/DesktopId"
        },
        "identity_hash": {
          "$ref": "#/$defs/WindowIdentityHash"
        },
        "observed_generation": {
          "format": "uint64-string",
          "maxLength": 20,
          "minLength": 1,
          "pattern": "^[1-9][0-9]{0,19}$",
          "type": "string"
        },
        "xid": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "desktop_id",
        "desktop_generation",
        "xid",
        "observed_generation",
        "identity_hash"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/AccessibilityPageCursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "desktop_generation": {
      "$ref": "#/$defs/DesktopGeneration"
    },
    "desktop_id": {
      "$ref": "#/$defs/DesktopId"
    },
    "expansion": {
      "$ref": "#/$defs/ElementSnapshotExpansion",
      "default": {
        "component": true,
        "text_metadata": false,
        "value": false
      }
    },
    "limit": {
      "default": 100,
      "format": "uint16",
      "maximum": 1000,
      "minimum": 1,
      "type": "integer"
    },
    "limits": {
      "$ref": "#/$defs/AccessibilityQueryLimits",
      "default": {
        "max_depth": 64,
        "max_matches": 1000,
        "max_visited_nodes": 25000,
        "timeout_ms": 10000
      }
    },
    "order": {
      "$ref": "#/$defs/ElementOrder"
    },
    "scope": {
      "$ref": "#/$defs/ElementScope"
    }
  },
  "required": [
    "desktop_id",
    "desktop_generation",
    "scope",
    "order"
  ],
  "title": "ElementListRequest",
  "type": "object"
}
